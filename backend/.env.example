WORKER_HOST=127.0.0.1
WORKER_PORT=8787
LOG_LEVEL=info
LOG_DIR=backend/runtime/logs
MAX_LOG_FILE_BYTES=5242880
LOG_RETENTION_DAYS=14
REQUEST_TIMEOUT_MS=10000
LOCAL_WORKER_HOST=127.0.0.1
LOCAL_WORKER_PORT=8787
LOCAL_WORKER_DATA_DIR=backend/.runtime
LOCAL_WORKER_CHECKPOINT_PATH=backend/.runtime/checkpoint.json
LOCAL_WORKER_EVENT_PATH=backend/.runtime/events.jsonl
PREVIEW_WORKER_ALLOWED_ORIGIN=http://127.0.0.1:8088,http://localhost:8088
# Optional DeepSeek dialogue provider. Keep the key in the process environment;
# never commit it to the repository.
DEEPSEEK_API_KEY=
DEEPSEEK_KEY_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional preview-only story save/session directories.
STORY_RUNTIME_DATA_DIR=backend/.runtime-story
AI_DIALOGUE_DATA_DIR=backend/.runtime-ai
